# RK3506B edge controller. Copy to /etc/zhirun-rk3506.env.
ZHIRUN_SERVER=http://8.145.49.45
ZHIRUN_TOKEN=REPLACE_WITH_PUSH_TOKEN
ZHIRUN_DEVICE_ID=rk3506b-01
ZHIRUN_DEVICE_NAME=RK3506B 水肥控制器

# USB-RS485 adapter connected to the RK3506B USB host. If the configured node
# changes after a hub reconnect, the collector automatically finds ttyUSB*.
ZHIRUN_RS485_PORT=/dev/ttyUSB0
ZHIRUN_RS485_BAUD=4800
ZHIRUN_MODBUS_TIMEOUT_S=0.6
ZHIRUN_SENSOR_RETRY_COUNT=3
ZHIRUN_SENSOR_HOLD_S=30

# ESP32 control UART. The configured path is tried first; USB serial adapters
# are then identified by the ESP32 STATUS/STATE protocol, independent of tty
# numbering and insertion order.
ZHIRUN_ESP_SERIAL_PORT=/dev/ttyS1
ZHIRUN_ESP_SERIAL_BAUD=115200

ZHIRUN_POLL_INTERVAL_S=0.5
ZHIRUN_PUSH_INTERVAL_S=5
ZHIRUN_SOIL_ADDR=2
ZHIRUN_TH_ADDR=1
ZHIRUN_CO2_ADDR=3
ZHIRUN_LIGHT_ADDR=5
ZHIRUN_WIND_ADDR=4
ZHIRUN_WIND_REG=0
# Optional RS485 rain gauge. If it is absent, the collector uses the tipping
# bucket values reported by the ESP32 GPIO18 input.
ZHIRUN_RAIN_ADDR=6
ZHIRUN_RAIN_REG=0
ZHIRUN_RAIN_FUNCTION=3
ZHIRUN_RAIN_SCALE=0.1
ZHIRUN_RAIN_MM_PER_TIP=0.3
