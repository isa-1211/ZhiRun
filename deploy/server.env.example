# Local deployment variables for the Ubuntu public server.
# Keep the real file as .env; it is ignored by Git.
ZHIRUN_HOST=8.145.49.45
ZHIRUN_USER=root
ZHIRUN_PWD=REPLACE_WITH_SSH_PASSWORD
# Optional; leave empty to allow unauthenticated local testing.
ZHIRUN_PUSH_TOKEN=
ZHIRUN_PORT=10000
# Daily model inference uses the server local timezone and runs once at 12:00.
# It records the decision but does not start pumps unless explicitly enabled.
ZHIRUN_AUTO_MODEL_ENABLED=1
ZHIRUN_AUTO_MODEL_EXECUTE=0
ZHIRUN_AUTO_MODEL_HOUR=12
ZHIRUN_AUTO_MODEL_MINUTE=0
ZHIRUN_AUTO_MODEL_N_G_L=100
ZHIRUN_AUTO_MODEL_P_G_L=80
ZHIRUN_AUTO_MODEL_K_G_L=120
