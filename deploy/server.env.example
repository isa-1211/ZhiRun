# Local deployment variables for the Ubuntu public server.
# Keep the real file as .env; it is ignored by Git.
ZHIRUN_HOST=8.145.49.45
ZHIRUN_USER=root
ZHIRUN_PWD=REPLACE_WITH_SSH_PASSWORD
# Optional; leave empty to allow unauthenticated local testing.
ZHIRUN_PUSH_TOKEN=REPLACE_WITH_DEVICE_TOKEN
ZHIRUN_PORT=10000
# Generate a long random value and keep it stable. Changing it invalidates
# sessions, verification codes, and pending WeChat/account links.
ZHIRUN_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ZHIRUN_AUTH_DB=/opt/zhirun/data/zhirun_auth.sqlite3
# Set to 1 when the public browser endpoint is HTTPS.
ZHIRUN_AUTH_COOKIE_SECURE=0

# SMS provider adapter. The service sends JSON containing phone, code, and
# purpose to this HTTPS endpoint. Never enable the development code publicly.
ZHIRUN_SMS_WEBHOOK=
ZHIRUN_SMS_WEBHOOK_TOKEN=
ZHIRUN_AUTH_DEV_CODE=

# WeChat Open Platform website application settings. The redirect URI must be
# registered in WeChat and point to /auth/wechat/callback on this service.
ZHIRUN_WECHAT_APP_ID=
ZHIRUN_WECHAT_APP_SECRET=
ZHIRUN_WECHAT_REDIRECT_URI=https://example.com/auth/wechat/callback
# Daily model inference uses the server local timezone and runs once at 12:00.
# It records the decision but does not start pumps unless explicitly enabled.
ZHIRUN_AUTO_MODEL_ENABLED=1
ZHIRUN_AUTO_MODEL_EXECUTE=1
ZHIRUN_AUTO_MODEL_HOUR=12
ZHIRUN_AUTO_MODEL_MINUTE=0
ZHIRUN_AUTO_MODEL_N_G_L=100
ZHIRUN_AUTO_MODEL_P_G_L=80
ZHIRUN_AUTO_MODEL_K_G_L=120
